# ==============================================================================
# Creative Studio Environment Variables
# ==============================================================================

# 1. B-Roll Footage & AI Video Providers
# Google Veo 3.1 & Custom AI Video Directory (Defaults to Google Drive if mounted)
VEO_BROLL_DIR="G:/My Drive/Agency Deliverables/veo_broll"

# Pexels: Free 4K & HD video API (Get key at: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay: Free video & sound effects API (Get key at: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_key_here

# 2. LLM Provider (Google Gemini, OpenAI, Anthropic, or Groq)
# Google Gemini 3.5 Flash / Gemini 3 / 2.0 (100% Free tier at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq High-Speed Free Tier (Llama 3.3 70B @ 500 tokens/sec at: https://console.groq.com)
# GROQ_API_KEY=your_groq_api_key_here

# Optional Alternative Providers (OpenAI GPT-4o-mini, Anthropic Claude 3.7 Sonnet)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. Observability & Tracing (Free Cloud Tier - 50k traces/month at https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# 4. Cross-Platform Cloud Storage
# Dynamic path (Defaults to G:/ on Windows, ~/Google Drive/ on macOS/Linux, or ./agency_deliverables)
AGENCY_DRIVE_PATH="G:/My Drive/Agency Deliverables"
GDRIVE_DELIVERY_DIR="G:/My Drive/Agency Deliverables"

# Optional Cloudflare R2 (10GB Free, $0 Egress Fees)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=agency-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-your_r2_id.r2.dev

