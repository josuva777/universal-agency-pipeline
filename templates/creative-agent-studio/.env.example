# ==============================================================================
# Creative Studio Environment Variables
# ==============================================================================

# 1. B-Roll Footage Providers (100% Free Tiers)
# Pexels: Free 4K & HD video API (Get key at: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay: Free video & sound effects API (Get key at: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_key_here

# 2. LLM Provider (Choose OpenAI, Anthropic, or free Groq)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# 3. Observability & Tracing (Free Cloud Tier - 50k traces/month at https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# 4. Cloudflare R2 Free Cloud Storage (10GB Free, $0 Egress Fees)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=agency-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-your_r2_id.r2.dev

