# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinelops?schema=public"

# Auth & Security
NEXTAUTH_SECRET="generate-a-secure-32-byte-hex-string"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Billing
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email / SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="security@sentinelops.ai"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="SentinelOps Security <security@sentinelops.ai>"

# Observability
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL="info"

